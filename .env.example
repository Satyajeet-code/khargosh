# Copy this file to .env and fill in only the keys that you use.
# Use new keys only for this project, each with a spending limit (D18).

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Langfuse Cloud (D26). Leave the keys empty to run without tracing.
# Regions: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US),
#          https://jp.cloud.langfuse.com (Japan)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
